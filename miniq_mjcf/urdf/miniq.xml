      <joint joint="fl_joint0" coef="-1"/>
      <joint joint="fl_joint1" coef="1"/>
    </fixed>
    <fixed name="br_belt">
      <joint joint="br_knee_motor" coef="1"/>
      <joint joint="br_joint0" coef="-1"/>
      <joint joint="br_joint1" coef="1"/>
    </fixed>
    <fixed name="bl_belt">
      <joint joint="bl_knee_motor" coef="1"/>
      <joint joint="bl_joint0" coef="-1"/>
      <joint joint="bl_joint1" coef="1"/>
    </fixed>
  </tendon>

  <equality>
    <tendon tendon1="fr_belt"/>
    <tendon tendon1="fl_belt"/>
    <tendon tendon1="br_belt"/>
    <tendon tendon1="bl_belt"/>
  </equality>

